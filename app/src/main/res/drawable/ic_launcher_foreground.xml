<?xml version="1.0" encoding="utf-8"?>
<!--
    Barbell + checkmark — 108×108 viewport (adaptive icon standard).
    Safe zone: center 72×72 (from 18,18 to 90,90).

    Layout:
      Barbell sits in lower portion of safe zone (y=58..82)
      Checkmark sits above barbell, slightly right of center
      All shapes render in white for high contrast on the burnt-orange background
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Drop shadow under barbell (subtle dark offset) ──────────── -->
    <path
        android:fillColor="#33000000"
        android:pathData="
          M22,62 H26 A6,6 0 0,1 32,68 V80 A6,6 0 0,1 26,86 H22 A6,6 0 0,1 16,80 V68 A6,6 0 0,1 22,62 Z
          M86,62 H90 A6,6 0 0,1 96,68 V80 A6,6 0 0,1 90,86 H86 A6,6 0 0,1 80,80 V68 A6,6 0 0,1 86,62 Z
          M32,71 H80 V77 H32 Z"/>

    <!-- ── Left plate ──────────────────────────────────────────────── -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M20,58 H24 A6,6 0 0,1 30,64 V76 A6,6 0 0,1 24,82 H20 A6,6 0 0,1 14,76 V64 A6,6 0 0,1 20,58 Z"/>

    <!-- ── Right plate ─────────────────────────────────────────────── -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M84,58 H88 A6,6 0 0,1 94,64 V76 A6,6 0 0,1 88,82 H84 A6,6 0 0,1 78,76 V64 A6,6 0 0,1 84,58 Z"/>

    <!-- ── Bar connecting the plates ────────────────────────────────── -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,67 H78 V73 H30 Z"/>

    <!-- ── Checkmark above the bar ──────────────────────────────────── -->
    <!-- Stroke-style checkmark: shadow first, then white on top -->
    <path
        android:fillColor="#33000000"
        android:strokeColor="#33000000"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M37,40 L50,53 L75,28"/>

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M36,38 L49,51 L74,26"/>

</vector>
